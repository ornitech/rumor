# Override the redis log level just for this service.
# Central ../.env sets REDIS_LOG_LEVEL=notice; this wins because envFiles
# load after the central .env. The redis service's args contain the literal
# string `${REDIS_LOG_LEVEL}`, which rumor substitutes from this merged env
# before exec, so docker sees `redis-server --loglevel debug` and redis
# prints DEBUG-level boot messages.
REDIS_LOG_LEVEL=debug
