# Override the database password just for this service.
# Central ../.env sets POSTGRES_PASSWORD=changeme; this wins because envFiles
# load after the central .env. The db service's docker invocation uses bare
# `-e POSTGRES_PASSWORD` (no value), so docker forwards this value into the
# container. Verify with:
#   docker exec rumor-example-db env | grep POSTGRES_PASSWORD
POSTGRES_PASSWORD=db-local-secret
