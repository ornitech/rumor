{
  "processes": [
    {
      "name": "db",
      "command": "docker",
      "args": [
        "run", "--rm", "--name", "rumor-example-db",
        "-e", "POSTGRES_USER",
        "-e", "POSTGRES_PASSWORD",
        "-e", "POSTGRES_DB",
        "-p", "5432:5432",
        "postgres:16-alpine"
      ],
      "cwd": "./db",
      "envFiles": ["./.env", "./db/.env.local"]
    },
    {
      "name": "redis",
      "command": "bash",
      "args": [
        "-c",
        "exec docker run --rm --name rumor-example-redis -p 6379:6379 redis:7-alpine redis-server --loglevel \"$REDIS_LOG_LEVEL\""
      ],
      "cwd": "./redis",
      "envFiles": ["./.env", "./redis/.env.local"]
    },
    {
      "name": "api",
      "command": "python3",
      "args": ["server.py"],
      "cwd": "./api",
      "envFiles": ["./.env", "./api/.env.local"],
      "dependsOn": [
        { "name": "db",    "until": { "port": 5432 } },
        { "name": "redis", "until": { "port": 6379 } }
      ]
    },
    {
      "name": "frontend",
      "command": "python3",
      "args": ["server.py"],
      "cwd": "./frontend",
      "envFiles": ["./.env", "./frontend/.env.local"],
      "env": {
        "LOG_LEVEL": "warn"
      },
      "dependsOn": [
        { "name": "api", "until": { "port": 3000 } }
      ]
    }
  ]
}
