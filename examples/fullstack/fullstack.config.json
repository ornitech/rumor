{
  "envFiles": ["./.env"],
  "dynamicPorts": ["POSTGRES_PORT", "REDIS_PORT", "API_PORT", "FRONTEND_PORT"],
  "processes": [
    {
      "name": "db",
      "command": "docker",
      "args": [
        "run", "--rm", "--name", "rumor-example-db",
        "-e", "POSTGRES_USER",
        "-e", "POSTGRES_PASSWORD",
        "-e", "POSTGRES_DB",
        "-p", "${POSTGRES_PORT}:5432",
        "postgres:16-alpine"
      ],
      "cwd": "./db",
      "envFiles": ["./db/.env.local"],
      "retry": { "maxRetries": 5, "strategy": "exponential", "delayMs": 1000, "maxDelayMs": 30000 }
    },
    {
      "name": "redis",
      "command": "docker",
      "args": [
        "run", "--rm", "--name", "rumor-example-redis",
        "-p", "${REDIS_PORT}:6379",
        "redis:7-alpine",
        "redis-server", "--loglevel", "${REDIS_LOG_LEVEL}"
      ],
      "cwd": "./redis",
      "envFiles": ["./redis/.env.local"],
      "retry": { "maxRetries": 3, "delayMs": 2000 }
    },
    {
      "name": "api",
      "command": "python3",
      "args": ["server.py"],
      "cwd": "./api",
      "envFiles": ["./api/.env.local"],
      "tags": ["backend"],
      "dependsOn": [
        { "name": "db",    "until": { "port": "${POSTGRES_PORT}" } },
        { "name": "redis", "until": { "port": "${REDIS_PORT}" } }
      ],
      "retry": { "maxRetries": 5, "strategy": "linear", "delayMs": 1000, "maxDelayMs": 10000 }
    },
    {
      "name": "frontend",
      "command": "python3",
      "args": ["server.py"],
      "cwd": "./frontend",
      "envFiles": ["./frontend/.env.local"],
      "env": {
        "LOG_LEVEL": "warn"
      },
      "tags": ["frontend"],
      "dependsOn": [
        { "name": "api", "until": { "port": "${API_PORT}" } }
      ],
      "retry": { "maxRetries": 3, "strategy": "exponential", "delayMs": 500, "maxDelayMs": 8000 }
    }
  ]
}
