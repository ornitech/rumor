# Override the redis log level just for this service.
# Central ../.env sets REDIS_LOG_LEVEL=notice; this wins because envFiles
# load after the central .env. The redis service is launched through a
# `bash -c` wrapper that expands $REDIS_LOG_LEVEL into the `redis-server
# --loglevel` argument, so this override is visible in the redis tab's
# stdout (it prints DEBUG-level messages on startup).
REDIS_LOG_LEVEL=debug
