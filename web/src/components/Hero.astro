---
import InstallTabs from "./InstallTabs.astro";
import { REPO_URL } from "../consts.ts";
---
<section class="hero" data-station="welcome" data-accent="running">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">a process orchestrator that lives in your terminal</p>
      <h1 class="display hero-title">
        run your whole&nbsp;stack<br />
        in <span class="hl">one window</span>.
      </h1>
      <p class="hero-sub dim">
        One JSON file describes every process. rumor runs them side by side — each
        in its own tab — gates them on one another, restarts the ones that crash,
        and hands each its own port. No more ten terminals and a prayer.
      </p>

      <div class="hero-install"><InstallTabs id="hero" compact /></div>

      <div class="hero-cta">
        <a class="btn primary" href="#install">Install rumor</a>
        <a class="btn" href={REPO_URL} rel="noopener">View source</a>
      </div>
    </div>

    <div class="hero-session">
      <div class="term hero-term" style="--scene-accent: var(--running)">
        <div class="term-bar">
          <span class="lights"><i></i><i></i><i></i></span>
          <span class="term-title">rumor · <b>myapp</b></span>
          <span class="spacer"></span>
          <span class="term-run"><i class="dot running"></i>live</span>
        </div>
        <div class="term-tabs">
          <span class="term-tab"><i class="dot running"></i>db</span>
          <span class="term-tab"><i class="dot running"></i>redis</span>
          <span class="term-tab selected"><i class="dot running"></i>api</span>
          <span class="term-tab"><i class="dot pending"></i>web</span>
        </div>
        <div class="term-body">
          <div class="term-line">[api] starting uvicorn on http://127.0.0.1:8000</div>
          <div class="term-line" style="color: var(--running)">[api] INFO  Application startup complete</div>
          <div class="term-line">[api] GET /health 200  1.2ms</div>
          <div class="term-line" style="color: var(--pending)">[web] waiting for api · tcp :8000</div>
          <div class="term-line" style="color: var(--running)">[web] ready on http://localhost:5173</div>
          <div class="term-line">[api] GET /api/orders 200  8.4ms<span class="caret">▌</span></div>
        </div>
        <div class="term-foot">
          <span class="seg-mode">boot</span>
          <span class="seg-text">4 processes · 1 config</span>
          <span class="seg-spacer"></span>
          <span class="seg-clock">● 3 up</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: 64px 0 52px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: center;
  }
  .hero-copy { min-width: 0; }
  .eyebrow { margin-bottom: 22px; }
  .hero-title {
    font-size: clamp(38px, 5.6vw, 68px);
    margin: 0 0 24px;
  }
  .hero-title .hl { color: var(--running); }
  .hero-sub {
    font-size: 15px;
    line-height: 1.7;
    max-width: 36em;
    margin: 0 0 30px;
  }
  .hero-install { max-width: 560px; }
  .hero-cta { display: flex; gap: 11px; margin-top: 24px; flex-wrap: wrap; }

  .hero-session { min-width: 0; }
  .caret {
    color: var(--running);
    animation: blink 1.1s steps(1) infinite;
    margin-left: 1px;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }

  @media (max-width: 940px) {
    .hero-grid { grid-template-columns: 1fr; gap: 38px; }
    .hero-session { order: -1; }
    .hero-title { font-size: clamp(36px, 9vw, 56px); }
  }
</style>
