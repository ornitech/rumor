#!/bin/sh
# Enforce Conventional Commits on the commit subject. Mirrors the types allowed
# by .github/workflows/pr-title-lint.yml so local commits match what CI accepts
# on the (squash-merged) PR title that release-please ultimately parses.
#
# Activate once per clone:  git config core.hooksPath .githooks

set -eu

msg_file="$1"

# First line that isn't blank or a comment is the subject.
subject="$(grep -vE '^[[:space:]]*#' "$msg_file" | grep -vE '^[[:space:]]*$' | head -n1 || true)"

# Let git's own machinery handle empty messages (it aborts the commit itself).
[ -n "$subject" ] || exit 0

# Merge commits and revert auto-messages are generated by git; don't reject them.
case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

types='feat|fix|refactor|chore|docs|test|ci|build|perf|style|revert'

# type, optional (scope), optional ! for breaking change, ": ", then a description.
if printf '%s' "$subject" | grep -qE "^(${types})(\([a-z0-9._-]+\))?!?: .+"; then
    exit 0
fi

cat >&2 <<EOF
✗ Commit message does not follow Conventional Commits.

  Subject: $subject

  Expected: <type>[(scope)][!]: <description>
  Types:    feat fix refactor chore docs test ci build perf style revert

  Examples:
    feat(cli): add 'rumor update' subcommand
    fix: handle missing rumor.json
    refactor(ui)!: drop the legacy banner layout
EOF
exit 1
